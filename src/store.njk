---
pagination:
  data: stores.stores
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/index.html"
---
{% if store.tablecheck_url %}
  {% set resHref = store.tablecheck_url + "?utm_source=lp&utm_medium=referral" %}
  {% set resLabel = "Reserve a seat" %}
  {% set resExternal = true %}
{% elif store.tel_raw %}
  {% set resHref = "tel:+" + store.tel_raw %}
  {% set resLabel = "Call to reserve" %}
  {% set resExternal = false %}
{% else %}
  {% set resHref = "#reserve" %}
  {% set resLabel = "Reserve a seat" %}
  {% set resExternal = false %}
{% endif %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ store.name_full_en }} {{ store.name_cn }}</title>
<meta name="description" content="{{ store.name_full_en }} {{ store.name_cn }} — Michelin chef supervised, 100% halal Japanese Wagyu in {{ store.area }}. Reservations recommended.">
<meta property="og:title" content="{{ store.name_full_en }} · {{ store.name_cn }}">
<meta property="og:description" content="Michelin chef supervised halal Wagyu in {{ store.area }}.">
<meta property="og:type" content="restaurant">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@300;400;500;600&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Sans+SC:wght@400;500&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  :root {
    --red: #D10100;
    --red-deep: #A50000;
    --red-dark: #7A0000;
    --ink: #1A1110;
    --white: #FFFFFF;
    --cream: #FFF6F2;
    --gold: #E8B84B;
  }
  body {
    font-family: 'Noto Sans JP', sans-serif;
    font-weight: 400;
    color: var(--ink);
    background: var(--white);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  .anton { font-family: 'Anton', sans-serif; font-weight: 400; }

  /* ============ OPENING ============ */
  .opening {
    position: fixed; inset: 0; z-index: 9999;
    background: var(--red);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    overflow: hidden;
    animation: openOut 0.7s ease 2.8s forwards;
  }
  .opening::before {
    content: '';
    position: absolute; width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, transparent 60%);
    animation: steamPulse 3s ease-in-out infinite;
  }
  .open-flower {
    width: 44px; height: 44px;
    opacity: 0; transform: scale(0.6);
    animation: popIn 0.7s cubic-bezier(.2,.8,.2,1) 0.2s forwards;
    margin-bottom: 18px; z-index: 2;
  }
  .open-michelin {
    font-family: 'Anton', sans-serif;
    font-size: 56px;
    color: var(--white);
    letter-spacing: 0.04em;
    line-height: 0.9;
    opacity: 0; transform: translateY(20px);
    animation: riseIn 0.7s cubic-bezier(.2,.8,.2,1) 0.5s forwards;
    z-index: 2;
  }
  .open-name {
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 0.4em;
    text-indent: 0.4em;
    text-transform: uppercase;
    color: var(--white);
    margin-top: 14px;
    opacity: 0;
    animation: fadeIn 0.7s ease 0.9s forwards;
    z-index: 2;
  }
  .open-bar {
    width: 0; height: 3px; background: var(--white);
    margin-top: 20px;
    animation: barGrow 0.8s ease 1.1s forwards;
    z-index: 2;
  }
  @keyframes popIn { to { opacity: 1; transform: scale(1); } }
  @keyframes riseIn { to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeIn { to { opacity: 1; } }
  @keyframes barGrow { to { width: 160px; } }
  @keyframes steamPulse { 0%,100% { transform: scale(0.8); opacity: 0.6; } 50% { transform: scale(1.1); opacity: 1; } }
  @keyframes openOut { to { opacity: 0; visibility: hidden; transform: translateY(-30px); } }

  .page { opacity: 0; animation: pageIn 0.8s ease 3s forwards; }
  @keyframes pageIn { to { opacity: 1; } }

  /* ============ HEADER ============ */
  .header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 14px 20px;
    display: flex; align-items: center; justify-content: space-between;
    background: var(--red);
    transition: padding 0.3s ease, box-shadow 0.3s ease;
    gap: 12px;
  }
  .header.scrolled { padding: 10px 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.25); }
  .header-logo { display: flex; align-items: center; gap: 9px; min-width: 0; }
  .header-mark { width: 20px; height: 20px; flex-shrink: 0; }
  .header-text {
    font-family: 'Oswald', sans-serif;
    font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--white);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .header-reserve {
    flex-shrink: 0;
    font-family: 'Oswald', sans-serif;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--red); background: var(--white);
    text-decoration: none;
    padding: 9px 18px;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  .header-reserve:hover { background: var(--gold); }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: center;
    overflow: hidden;
    background: var(--red);
  }
  .hero-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    transform: scale(1.12);
    animation: heroZoom 7s ease-out 3s forwards;
  }
  @keyframes heroZoom { to { transform: scale(1); } }
  .hero-veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(209,1,0,0.55) 0%, rgba(26,17,16,0.15) 35%, rgba(26,17,16,0.35) 62%, rgba(122,0,0,0.88) 100%);
  }
  .hero-content {
    position: relative; z-index: 2;
    width: 100%;
    padding: 96px 24px 64px;
    color: var(--white);
    text-align: center;
  }
  .hero-flower {
    width: 32px; height: 32px;
    margin: 0 auto 16px;
    opacity: 0; animation: fadeIn 0.8s ease 3.2s forwards;
  }
  .hero-rule {
    width: 200px; max-width: 60%;
    height: 2px; background: var(--white);
    margin: 0 auto 18px;
    transform: scaleX(0);
    animation: ruleIn 0.8s ease 3.3s forwards;
  }
  @keyframes ruleIn { to { transform: scaleX(1); } }
  .hero-michelin {
    font-family: 'Anton', sans-serif;
    font-size: 64px;
    letter-spacing: 0.06em;
    line-height: 0.92;
    text-transform: uppercase;
    margin-bottom: 8px;
    opacity: 0; transform: translateY(24px);
    animation: riseIn 0.9s cubic-bezier(.2,.8,.2,1) 3.4s forwards;
  }
  .hero-supervised {
    font-family: 'Oswald', sans-serif;
    font-weight: 300;
    font-size: 15px;
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    text-transform: uppercase;
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeIn 0.8s ease 3.7s forwards;
  }
  .hero-title {
    font-family: 'Anton', sans-serif;
    font-size: 34px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 8px;
    opacity: 0; transform: translateY(24px);
    animation: riseIn 0.9s cubic-bezier(.2,.8,.2,1) 3.9s forwards;
  }
  .hero-cn {
    font-family: 'Noto Sans SC', sans-serif;
    font-size: 14px;
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    opacity: 0;
    margin-bottom: 32px;
    animation: fadeIn 0.8s ease 4.2s forwards;
  }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red); background: var(--white);
    text-decoration: none;
    padding: 17px 40px;
    opacity: 0; transform: translateY(16px);
    animation: riseIn 0.8s ease 4.4s forwards;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .hero-cta:hover { background: var(--gold); transform: translateY(-2px); }
  .hero-cta svg { transition: transform 0.25s ease; }
  .hero-cta:hover svg { transform: translateX(4px); }

  /* ============ SECTION ============ */
  section { padding: 80px 24px; }
  .container { max-width: 1160px; margin: 0 auto; }
  .eyebrow {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.4em;
    text-indent: 0.4em;
    text-transform: uppercase;
    color: var(--red);
    text-align: center;
    margin-bottom: 14px;
  }
  .section-title {
    font-family: 'Anton', sans-serif;
    font-size: 40px;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.02;
    letter-spacing: 0.02em;
    margin-bottom: 20px;
    color: var(--ink);
  }
  .red-rule { width: 56px; height: 4px; background: var(--red); margin: 0 auto 32px; }
  .section-lead {
    text-align: center; max-width: 540px; margin: 0 auto 52px;
    font-size: 16px; line-height: 1.85; color: #4a3a38;
  }

  /* ============ PHILOSOPHY ============ */
  .philosophy { background: var(--cream); }
  .pillars { display: flex; flex-direction: column; gap: 16px; }
  .pillar {
    background: var(--white);
    padding: 32px 26px;
    text-align: center;
    border-top: 5px solid var(--red);
    box-shadow: 0 8px 30px rgba(209,1,0,0.06);
  }
  .pillar-num { font-family: 'Anton', sans-serif; font-size: 34px; color: var(--red); line-height: 1; margin-bottom: 12px; }
  .pillar-title { font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 19px; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px; }
  .pillar-text { font-size: 15px; color: #5a4a48; line-height: 1.8; }

  /* ============ GALLERY ============ */
  .gallery { background: var(--ink); padding: 80px 0; }
  .gallery .eyebrow { color: var(--gold); }
  .gallery .section-title { color: var(--white); }
  .gallery-track { padding: 0 24px; }
  .gallery-big {
    width: 100%; height: 56vh; max-height: 460px;
    background-size: cover; background-position: center;
    margin-bottom: 14px; position: relative;
    overflow: hidden;
  }
  .gallery-big::after, .gallery-cell::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6), transparent 50%);
  }
  .gallery-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .gallery-cell { height: 190px; background-size: cover; background-position: center; position: relative; overflow: hidden; }
  .gallery-label {
    position: absolute; left: 18px; bottom: 16px; z-index: 2;
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--white);
  }

  /* ============ COURSE MENU ============ */
  .courses { background: var(--white); }
  .course-grid { display: flex; flex-direction: column; gap: 24px; max-width: 900px; margin: 0 auto; }
  .course-card {
    background: var(--cream);
    padding: 34px 28px;
    border-top: 5px solid var(--gold);
    box-shadow: 0 8px 30px rgba(209,1,0,0.06);
  }
  .course-card.platinum { border-top-color: var(--ink); }
  .course-name {
    font-family: 'Anton', sans-serif;
    font-size: 30px; letter-spacing: 0.03em;
    text-transform: uppercase; color: var(--gold); line-height: 1;
  }
  .course-card.platinum .course-name { color: var(--ink); }
  .course-kicker {
    font-family: 'Oswald', sans-serif; font-weight: 600;
    font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase;
    color: #b98a2e; margin-bottom: 20px; margin-top: 4px;
  }
  .course-card.platinum .course-kicker { color: #8a7a78; }
  .course-list { list-style: none; }
  .course-list > li {
    display: flex; gap: 14px; align-items: flex-start;
    padding: 15px 0; border-bottom: 1px solid rgba(26,17,16,0.1);
  }
  .course-list > li:last-child { border-bottom: 0; }
  .course-idx { font-family: 'Anton', sans-serif; color: var(--red); font-size: 18px; line-height: 1.5; min-width: 24px; }
  .course-card.platinum .course-idx { color: var(--ink); }
  .course-item-jp { font-family: 'Noto Sans JP', sans-serif; font-weight: 500; font-size: 16px; color: var(--ink); }
  .course-item-en { font-family: 'Oswald', sans-serif; font-weight: 300; font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: #9a7a76; display: block; margin-top: 2px; }
  .course-sub { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .course-sub li { position: relative; padding-left: 18px; font-size: 14px; color: #5a4a48; }
  .course-sub li::before { content: "—"; position: absolute; left: 0; color: var(--gold); }
  .course-sub .en { font-family: 'Oswald', sans-serif; font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: #a08a86; margin-left: 6px; }

  /* ============ HALAL ============ */
  .halal { background: var(--red); color: var(--white); position: relative; overflow: hidden; }
  .halal::before {
    content: ''; position: absolute; top: -120px; right: -120px;
    width: 380px; height: 380px;
    border: 2px solid rgba(255,255,255,0.12); border-radius: 50%;
  }
  .halal .eyebrow { color: var(--white); }
  .halal .section-title { color: var(--white); }
  .halal-emblem {
    width: 150px; height: 150px;
    border: 2px solid var(--white); border-radius: 50%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    margin: 0 auto 36px;
  }
  .halal-emblem .ar { font-size: 48px; line-height: 1; margin-bottom: 4px; }
  .halal-emblem .en { font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 13px; letter-spacing: 0.3em; text-indent: 0.3em; }
  .halal-text { text-align: center; max-width: 540px; margin: 0 auto 36px; font-size: 16px; line-height: 1.85; color: #ffe9e6; }
  .halal-list { list-style: none; max-width: 420px; margin: 0 auto; }
  .halal-list li { padding: 17px 0; border-bottom: 1px solid rgba(255,255,255,0.25); font-size: 15px; display: flex; align-items: center; gap: 14px; justify-content: center; }
  .halal-list li:first-child { border-top: 1px solid rgba(255,255,255,0.25); }
  .halal-list .check { color: var(--gold); font-weight: 700; }

  /* ============ QUOTE ============ */
  .quote-sec { background: var(--cream); text-align: center; }
  .quote-stars { color: var(--gold); letter-spacing: 0.4em; text-indent: 0.4em; font-size: 18px; margin-bottom: 24px; }
  .quote-body { font-family: 'Anton', sans-serif; font-size: 26px; line-height: 1.25; text-transform: uppercase; letter-spacing: 0.01em; max-width: 700px; margin: 0 auto 24px; color: var(--ink); }
  .quote-attr { font-family: 'Oswald', sans-serif; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--red); }

  /* ============ ACCESS ============ */
  .access { background: var(--white); }
  .access-grid { display: flex; flex-direction: column; gap: 14px; max-width: 620px; margin: 0 auto; }
  .access-row { display: flex; gap: 18px; padding: 18px 22px; background: var(--cream); border-left: 4px solid var(--red); }
  .access-k { font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--red); min-width: 92px; padding-top: 2px; }
  .access-v { font-size: 15px; color: var(--ink); line-height: 1.6; }
  .access-v a { color: inherit; text-decoration: none; }
  .access-v small { display: block; color: #8a6a66; font-size: 12.5px; }
  .access-map { margin: 28px auto 0; max-width: 900px; aspect-ratio: 16/9; border: 1px solid rgba(26,17,16,0.12); overflow: hidden; }
  .access-map iframe { width: 100%; height: 100%; border: 0; display: block; }

  /* ============ RESERVE ============ */
  .reserve { background: var(--ink); color: var(--white); text-align: center; }
  .reserve .eyebrow { color: var(--gold); }
  .reserve-title { font-family: 'Anton', sans-serif; font-size: 44px; text-transform: uppercase; line-height: 1.0; margin-bottom: 22px; }
  .reserve-text { font-size: 16px; max-width: 460px; margin: 0 auto 40px; color: #d8cdcb; line-height: 1.8; }
  .reserve-cta {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: 'Oswald', sans-serif; font-weight: 600;
    font-size: 15px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--white); background: var(--red);
    text-decoration: none; padding: 19px 52px;
    transition: all 0.25s ease;
  }
  .reserve-cta:hover { background: var(--red-deep); transform: translateY(-2px); }
  .reserve-cta svg { transition: transform 0.25s ease; }
  .reserve-cta:hover svg { transform: translateX(4px); }
  .reserve-tel { display: block; margin-top: 22px; font-family: 'Oswald', sans-serif; font-size: 14px; letter-spacing: 0.14em; color: #d8cdcb; }
  .reserve-tel a { color: var(--gold); text-decoration: none; }

  /* ============ FOOTER ============ */
  footer { background: var(--red-dark); color: rgba(255,255,255,0.7); padding: 52px 24px calc(96px + env(safe-area-inset-bottom)); text-align: center; }
  .footer-mark { width: 30px; height: 30px; margin: 0 auto 18px; }
  .footer-name { font-family: 'Oswald', sans-serif; font-size: 13px; letter-spacing: 0.12em; color: var(--white); line-height: 1.8; max-width: 460px; margin: 0 auto 16px; }
  footer p { font-size: 12px; opacity: 0.7; line-height: 1.7; }

  /* ============ STICKY ============ */
  .sticky-cta {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 90;
    background: var(--red);
    padding: 11px 16px calc(11px + env(safe-area-inset-bottom));
    display: flex; align-items: center; gap: 14px;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.2);
    transform: translateY(100%);
    animation: stickyIn 0.5s ease 4.6s forwards;
  }
  @keyframes stickyIn { to { transform: translateY(0); } }
  .sticky-text { flex: 1; min-width: 0; color: var(--white); }
  .sticky-text .l { display: block; font-family: 'Oswald', sans-serif; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.9; margin-bottom: 1px; }
  .sticky-text .v { font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; }
  .sticky-btn { flex-shrink: 0; font-family: 'Oswald', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--red); background: var(--white); text-decoration: none; padding: 13px 22px; }

  /* ============ REVEAL ============ */
  .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.8s ease, transform 0.8s ease; }
  .reveal.in { opacity: 1; transform: translateY(0); }

  /* ============ DESKTOP ============ */
  @media (min-width: 700px) {
    .hero-michelin { font-size: 110px; }
    .hero-title { font-size: 56px; }
    .hero-supervised { font-size: 18px; }
    section { padding: 110px 48px; }
    .section-title { font-size: 56px; }
    .pillars { flex-direction: row; }
    .pillar { flex: 1; }
    .gallery-big { height: 64vh; max-height: 620px; }
    .gallery-cell { height: 280px; }
    .course-grid { flex-direction: row; align-items: stretch; }
    .course-card { flex: 1; }
    .halal-emblem { width: 180px; height: 180px; }
    .quote-body { font-size: 38px; }
    .reserve-title { font-size: 72px; }
    .sticky-cta { display: none; }
    footer { padding-bottom: 52px; }
    .header { padding: 16px 48px; }
    .header-text { font-size: 13px; }
  }
  @media (min-width: 1000px) {
    .hero-michelin { font-size: 140px; }
  }
</style>
</head>
<body>

<!-- OPENING -->
<div class="opening" id="opening">
  <svg class="open-flower" viewBox="0 0 32 32" fill="none">
    <circle cx="16" cy="16" r="2.5" fill="#fff"/>
    <ellipse cx="16" cy="6.5" rx="2.6" ry="5" fill="#fff"/><ellipse cx="16" cy="25.5" rx="2.6" ry="5" fill="#fff"/>
    <ellipse cx="6.5" cy="16" rx="5" ry="2.6" fill="#fff"/><ellipse cx="25.5" cy="16" rx="5" ry="2.6" fill="#fff"/>
    <ellipse cx="9.4" cy="9.4" rx="4" ry="2.2" fill="#fff" transform="rotate(-45 9.4 9.4)"/>
    <ellipse cx="22.6" cy="22.6" rx="4" ry="2.2" fill="#fff" transform="rotate(-45 22.6 22.6)"/>
    <ellipse cx="22.6" cy="9.4" rx="4" ry="2.2" fill="#fff" transform="rotate(45 22.6 9.4)"/>
    <ellipse cx="9.4" cy="22.6" rx="4" ry="2.2" fill="#fff" transform="rotate(45 9.4 22.6)"/>
  </svg>
  <div class="open-michelin">MICHELIN</div>
  <div class="open-name">{{ store.name_short }}</div>
  <div class="open-bar"></div>
</div>

<div class="page">

  <!-- HEADER -->
  <header class="header" id="header">
    <div class="header-logo">
      <svg class="header-mark" viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="2.5" fill="#fff"/>
        <ellipse cx="16" cy="6.5" rx="2.6" ry="5" fill="#fff"/><ellipse cx="16" cy="25.5" rx="2.6" ry="5" fill="#fff"/>
        <ellipse cx="6.5" cy="16" rx="5" ry="2.6" fill="#fff"/><ellipse cx="25.5" cy="16" rx="5" ry="2.6" fill="#fff"/>
      </svg>
      <span class="header-text">{{ store.name_full_en }} {{ store.name_cn }}</span>
    </div>
    <a href="{{ resHref }}"{% if resExternal %} target="_blank" rel="noopener"{% endif %} class="header-reserve">Reserve</a>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-img" style="background-image: url('{{ store.hero_image }}');"></div>
    <div class="hero-veil"></div>
    <div class="hero-content">
      <svg class="hero-flower" viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="2.5" fill="#fff"/>
        <ellipse cx="16" cy="6.5" rx="2.6" ry="5" fill="#fff"/><ellipse cx="16" cy="25.5" rx="2.6" ry="5" fill="#fff"/>
        <ellipse cx="6.5" cy="16" rx="5" ry="2.6" fill="#fff"/><ellipse cx="25.5" cy="16" rx="5" ry="2.6" fill="#fff"/>
      </svg>
      <div class="hero-rule"></div>
      <h1 class="hero-michelin">MICHELIN</h1>
      <div class="hero-supervised">Supervised</div>
      <div class="hero-title">{{ store.name_short }}</div>
      {% if store.name_cn %}<div class="hero-cn">{{ store.name_cn }}</div>{% endif %}
      <a href="{{ resHref }}"{% if resExternal %} target="_blank" rel="noopener"{% endif %} class="hero-cta">
        {{ resLabel }}
        <svg width="18" height="10" viewBox="0 0 18 10" fill="none"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.4"/></svg>
      </a>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section class="philosophy" id="philosophy">
    <div class="container">
      <p class="eyebrow reveal">Our Philosophy</p>
      <h2 class="section-title reveal">Three principles<br>One table</h2>
      <div class="red-rule reveal"></div>
      <p class="section-lead reveal">Every dish is built on three uncompromising commitments — to craft, to faith, and to the finest ingredients Japan has to offer.</p>
      <div class="pillars">
        <div class="pillar reveal">
          <div class="pillar-num">01</div>
          <h3 class="pillar-title">Michelin Supervised</h3>
          <p class="pillar-text">Every recipe, from broth to finishing oil, overseen by a Michelin Bib Gourmand chef.</p>
        </div>
        <div class="pillar reveal">
          <div class="pillar-num">02</div>
          <h3 class="pillar-title">Halal Muslim Friendly</h3>
          <p class="pillar-text">Every ingredient, utensil and process — uncompromisingly, transparently halal.</p>
        </div>
        <div class="pillar reveal">
          <div class="pillar-num">03</div>
          <h3 class="pillar-title">Wagyu</h3>
          <p class="pillar-text">Premium Japanese wagyu, prepared with restraint to honour its natural depth.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="gallery" id="gallery">
    <div class="container">
      <p class="eyebrow reveal">{{ store.gallery_eyebrow or "The Bowl" }}</p>
      <h2 class="section-title reveal">{{ store.gallery_title or "A study in detail" }}</h2>
    </div>
    <div class="gallery-track">
      {% for g in store.gallery %}
        {% if loop.first %}
        <div class="gallery-big reveal" style="background-image: url('{{ g.img }}');">
          <span class="gallery-label">{{ g.label }}</span>
        </div>
        <div class="gallery-row">
        {% else %}
        <div class="gallery-cell reveal" style="background-image: url('{{ g.img }}');">
          <span class="gallery-label">{{ g.label }}</span>
        </div>
        {% endif %}
        {% if loop.last %}</div>{% endif %}
      {% endfor %}
    </div>
  </section>

  {% if store.courses and store.courses.length %}
  <!-- COURSE MENU -->
  <section class="courses" id="menu">
    <div class="container">
      <p class="eyebrow reveal">{{ store.course_eyebrow or "The Course" }}</p>
      <h2 class="section-title reveal">{{ store.course_title or "Course Menu" }}</h2>
      <div class="red-rule reveal"></div>
      <div class="course-grid">
        {% for course in store.courses %}
        <div class="course-card reveal {% if course.name == 'Platinum' %}platinum{% endif %}">
          <div class="course-name">{{ course.name }}</div>
          <div class="course-kicker">Course</div>
          <ul class="course-list">
            {% for item in course.items %}
            <li>
              <span class="course-idx">{{ loop.index }}</span>
              <span>
                <span class="course-item-jp">{{ item.jp }}</span>
                {% if item.en %}<span class="course-item-en">{{ item.en }}</span>{% endif %}
                {% if item.sub and item.sub.length %}
                <ul class="course-sub">
                  {% for s in item.sub %}
                  <li>{{ s.jp }}{% if s.en %}<span class="en">{{ s.en }}</span>{% endif %}</li>
                  {% endfor %}
                </ul>
                {% endif %}
              </span>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- HALAL -->
  <section class="halal" id="halal">
    <div class="container">
      <div class="halal-emblem reveal">
        <div class="ar">حلال</div>
        <div class="en">HALAL</div>
      </div>
      <p class="eyebrow reveal">Halal Assurance</p>
      <h2 class="section-title reveal">Dine with<br>peace of mind</h2>
      <div class="red-rule reveal" style="background:#fff;"></div>
      <p class="halal-text reveal">From the kitchen to the plate, every step is held to halal standards. No alcohol, no pork-derived ingredients, separate utensils and preparation — without exception.</p>
      <ul class="halal-list reveal">
        <li><span class="check">✓</span> Halal certified wagyu only</li>
        <li><span class="check">✓</span> No alcohol, no mirin</li>
        <li><span class="check">✓</span> Fully separated kitchen and utensils</li>
      </ul>
    </div>
  </section>

  <!-- QUOTE -->
  <section class="quote-sec">
    <div class="container">
      <div class="quote-stars reveal">★ ★ ★ ★ ★</div>
      <blockquote class="quote-body reveal">"Built on technique, restraint, and the quiet confidence of fine cooking."</blockquote>
      <p class="quote-attr reveal">Supervised by a Michelin Bib Gourmand chef</p>
    </div>
  </section>

  {% if store.address_jp or store.tel_display or store.hours %}
  <!-- ACCESS -->
  <section class="access" id="access">
    <div class="container">
      <p class="eyebrow reveal">Visit Us</p>
      <h2 class="section-title reveal">Find us in {{ store.area }}</h2>
      <div class="red-rule reveal"></div>
      <div class="access-grid">
        {% if store.address_jp or store.address_en %}
        <div class="access-row reveal">
          <span class="access-k">Address</span>
          <span class="access-v">
            {% if store.address_en %}{{ store.address_en }}{% endif %}
            <small>{{ store.address_jp }}{% if store.postal %} · {{ store.postal }}{% endif %}</small>
          </span>
        </div>
        {% endif %}
        {% if store.hours %}
        <div class="access-row reveal">
          <span class="access-k">Hours</span>
          <span class="access-v">{{ store.hours }}<small>Open daily</small></span>
        </div>
        {% endif %}
        {% if store.tel_display %}
        <div class="access-row reveal">
          <span class="access-k">Phone</span>
          <span class="access-v">
            <a href="tel:+{{ store.tel_raw }}">{{ store.tel_display }}</a>
            {% if store.tel_display2 %}<small><a href="tel:+{{ store.tel_raw2 }}">{{ store.tel_display2 }}</a></small>{% endif %}
          </span>
        </div>
        {% endif %}
      </div>
      {% if store.maps_embed %}
      <div class="access-map reveal">
        <iframe src="{{ store.maps_embed }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="{{ store.name_short }} — {{ store.area }} map"></iframe>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <!-- RESERVE -->
  <section class="reserve" id="reserve">
    <div class="container">
      <p class="eyebrow reveal">Reservations</p>
      <h2 class="reserve-title reveal">A seat at the table<br>awaits you</h2>
      <p class="reserve-text reveal">Seating is limited. Secure your place in advance and experience it at its finest, in the heart of {{ store.area }}.</p>
      <a href="{{ resHref }}"{% if resExternal %} target="_blank" rel="noopener"{% endif %} class="reserve-cta reveal">
        {{ resLabel }}
        <svg width="18" height="10" viewBox="0 0 18 10" fill="none"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.4"/></svg>
      </a>
      {% if store.tel_display %}
      <span class="reserve-tel reveal">Or call <a href="tel:+{{ store.tel_raw }}">{{ store.tel_display }}</a>{% if store.tel_display2 %} · <a href="tel:+{{ store.tel_raw2 }}">{{ store.tel_display2 }}</a>{% endif %}</span>
      {% endif %}
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <svg class="footer-mark" viewBox="0 0 32 32" fill="none">
      <circle cx="16" cy="16" r="2.5" fill="#fff"/>
      <ellipse cx="16" cy="6.5" rx="2.6" ry="5" fill="#fff"/><ellipse cx="16" cy="25.5" rx="2.6" ry="5" fill="#fff"/>
      <ellipse cx="6.5" cy="16" rx="5" ry="2.6" fill="#fff"/><ellipse cx="25.5" cy="16" rx="5" ry="2.6" fill="#fff"/>
    </svg>
    <div class="footer-name">{{ store.name_full_en }} {{ store.name_cn }}</div>
    <p>Recipes supervised by a Michelin Bib Gourmand chef. Not affiliated with Michelin.</p>
    <p>© {{ store.name_full_en }} {{ store.name_cn }}. All rights reserved.</p>
  </footer>

</div>

<!-- STICKY -->
<a href="{{ resHref }}"{% if resExternal %} target="_blank" rel="noopener"{% endif %} class="sticky-cta" style="text-decoration:none;">
  <div class="sticky-text">
    <span class="l">Seating is limited</span>
    <span class="v">{{ resLabel }}</span>
  </div>
  <span class="sticky-btn">{% if resExternal %}Reserve{% else %}Call{% endif %}</span>
</a>

<script>
  const header = document.getElementById('header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) header.classList.add('scrolled');
    else header.classList.remove('scrolled');
  });
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  document.getElementById('opening').addEventListener('click', function(){
    this.style.animation = 'none'; this.style.opacity = '0'; this.style.visibility = 'hidden';
    document.querySelector('.page').style.animation = 'none';
    document.querySelector('.page').style.opacity = '1';
  });
</script>

</body>
</html>
